{
    "name": "andreapeverelli/phx-core",
    "description": "A frontend hypermedia framework for PHP.",
    "type": "framework",
    "license": "GPL-3.0",
	"version": "0.2.10",
    "autoload": {
        "psr-4": {
            "AndreaPeverelli\\PhxCore\\": [
				"src/",
				"src/Component/",
				"src/App/",
                "src/Logger/",
                "src/Settings/"
			]
        },
        "classmap": [
            "src/Palette/Color.php",
            "src/Typography/Typo.php"
        ]
    },
    "authors": [
        {
            "name": "Andrea Peverelli",
			"email": "ndrpeverelli@gmail.com"
        }
    ],
	"minimum-stability": "stable",
	"scripts": {
		"test": "XDEBUG_MODE=coverage phpunit",
		"analyse": "phpstan analyse",
		"docs": "phpdoc",
		"lint": "php-cs-fixer check",
		"fix": "php-cs-fixer fix",
		"prepare": [
			"@fix",
			"@analyse",
			"@test",
			"@docs"
		]
	},
    "require": {
        "mustache/mustache": "^3.2",
        "psr/log": "^3.0",
        "monolog/monolog": "^3.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "phpstan/phpstan": "^2.2",
        "phpdocumentor/shim": "^3.10",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "config": {
        "allow-plugins": {
            "phpdocumentor/shim": true
        }
    }
}
